{
  "name": "@bismo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:docker": "nodemon --legacy-watch --watch src --watch ../../packages/db-models/src --watch ../../packages/shared-schemas/src --ext ts --exec \"bun run src/index.ts\"",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@bismo/db-models": "workspace:*",
    "@bismo/shared-schemas": "workspace:*",
    "@hono/standard-validator": "^0.4.0",
    "@scalar/hono-api-reference": "^0.11.16",
    "@socket.io/bun-engine": "^0.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.16",
    "hono-openapi": "^1.3.1",
    "hono-rate-limiter": "^0.4.2",
    "js-yaml": "^4.1.0",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1",
    "zod-openapi": "4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@bismo/config-typescript": "workspace:*",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "nodemon": "^3.1.14",
    "typescript": "^5.7.3"
  }
}
