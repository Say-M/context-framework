# Copy to apps/api/.env and fill in real values. Never commit the real .env file.

# Server
PORT=5500
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/bismo

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_INVITE_SECRET=

# Field-level PII encryption — must decode (base64) to exactly 32 bytes: openssl rand -base64 32
PII_ENCRYPTION_KEY=

# Deterministic email lookup hash secret (HMAC key) — generate with: openssl rand -base64 32
EMAIL_HASH_SECRET=
