# Two uses for this file:
#  - Local (non-Docker) dev: copy to apps/api/.env, and separately set
#    VITE_API_URL in apps/web/.env and apps/generator-web/.env — both
#    default to http://localhost:5500, matching PORT below.
#  - Docker: copy to ./.env at the repo root — both docker-compose.yml
#    (production) and docker-compose.dev.yml (development) read it.
# Never commit the real .env file.

# Server
PORT=5500
WEB_ORIGIN=http://localhost:5173
# Origin of apps/generator-web — the public, self-service generator app.
GENERATOR_WEB_ORIGIN=http://localhost:5174
NODE_ENV=development

# Database — must be a replica set (even a single-node one) for Mongoose
# multi-document transactions to work. docker-compose.dev.yml's mongo
# service already starts with --replSet rs0; for a native (non-Docker)
# mongod, add replicaSet/directConnection as shown, or drop them for a
# plain standalone instance that doesn't need transactions.
MONGODB_URI=mongodb://localhost:27017/bismo?replicaSet=rs0&directConnection=true

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_INVITE_SECRET=

# Field-level PII encryption — must decode (base64) to exactly 32 bytes: openssl rand -base64 32
PII_ENCRYPTION_KEY=

# Deterministic email lookup hash secret (HMAC key) — generate with: openssl rand -base64 32
EMAIL_HASH_SECRET=

# Where generated apps' git repos live on disk. Optional — defaults to
# ./data/generated-apps (relative to apps/api's cwd) if unset.
GENERATED_APPS_DIR=./data/generated-apps

# Claude Agent SDK credentials — the agent subprocess that scaffolds and
# iterates on generated apps reads these directly from process.env.
ANTHROPIC_API_KEY=
# Optional — only set to route through a compatible gateway instead of
# api.anthropic.com.
ANTHROPIC_BASE_URL=

# --- Docker only ---

# Public host ports for the web/generator-web nginx containers in
# production mode (docker-compose.yml). Not used in development mode (Vite
# always publishes on 5173/5174).
WEB_PORT=8080
GENERATOR_WEB_PORT=8081

# Host port docker-compose.dev.yml publishes the bundled Mongo container on.
MONGO_PORT=27017

# Baked into the web production build at `docker build` time (Vite env vars
# are compile-time, not runtime). Leave empty: nginx serves the app and
# proxies /api on the same origin, so the browser can call relative paths.
# Only set this if the API is deployed at a different origin than the web
# app.
VITE_API_URL=
